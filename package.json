{
  "name": "pocket-reader",
  "version": "1.0.0",
  "description": "Pocket Reader - Neural Audiobook PWA and Mobile App",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "cap:init": "npx @capacitor/cli init \"Pocket Reader\" com.pocketreader.app --web-dir public",
    "cap:add:android": "npx @capacitor/cli add android",
    "cap:add:ios": "npx @capacitor/cli add ios",
    "cap:sync": "npx @capacitor/cli sync",
    "cap:open:android": "npx @capacitor/cli open android",
    "cap:open:ios": "npx @capacitor/cli open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/keyboard": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
