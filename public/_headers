# Cloudflare Pages headers.
#
# DELIBERATELY ABSENT: Cross-Origin-Opener-Policy / Cross-Origin-Embedder-Policy.
# Do not add them here. Cross-origin isolation is opt-in per navigation, applied
# by the service worker only for ?tts_fast=1 narration sessions (see sw.js
# withNarrationIsolation). Setting COOP: same-origin globally severs OAuth popup
# relationships, which would break Google sign-in through Supabase. Threaded
# WASM still gets isolation on the narration path; everything else stays
# unisolated on purpose.

/sw.js
  # A stale service worker is effectively an un-updatable app. Always
  # revalidate; the worker itself manages asset caching.
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json

# JS and CSS are always requested with a ?v= tag and the tag is bumped whenever
# content changes, so the URL is effectively immutable.
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images and icons are referenced WITHOUT a version query, so they must stay
# revalidatable or a replaced icon would never reach existing users.
/assets/img/*
  Cache-Control: public, max-age=86400, must-revalidate

/assets/icons/*
  Cache-Control: public, max-age=86400, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
